{
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm ci --ignore-scripts)",
      "Bash(npm run *)",
      "Bash(npm install --save-exact --ignore-scripts *)",
      "Bash(npm install --save-dev --save-exact --ignore-scripts *)",
      "PowerShell(git status)",
      "PowerShell(git status *)",
      "PowerShell(git log)",
      "PowerShell(git log *)",
      "PowerShell(git diff)",
      "PowerShell(git diff *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(npm test)",
      "PowerShell(npm test *)",
      "PowerShell(npm ci --ignore-scripts)",
      "PowerShell(npm run *)",
      "PowerShell(npm install --save-exact --ignore-scripts *)",
      "PowerShell(npm install --save-dev --save-exact --ignore-scripts *)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset *)",
      "Bash(git rebase *)",
      "Bash(git clean *)",
      "Bash(rm *)",
      "Bash(rmdir *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(npx *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset *)",
      "PowerShell(git rebase *)",
      "PowerShell(git clean *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(rm *)",
      "PowerShell(del *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(curl *)",
      "Bash(npm start)",
      "Bash(npm start *)",
      "Bash(npm run start)",
      "Bash(npm run start *)",
      "Bash(node src/main.ts)",
      "Bash(node src/main.ts *)",
      "PowerShell(npm start)",
      "PowerShell(npm start *)",
      "PowerShell(npm run start)",
      "PowerShell(npm run start *)",
      "PowerShell(node src/main.ts)",
      "PowerShell(node src/main.ts *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./.env.development)",
      "Read(./.env.production)",
      "Read(./.env.test)",
      "Edit(./.env)",
      "Edit(./.env.local)",
      "Edit(./.env.*.local)",
      "Edit(./.env.development)",
      "Edit(./.env.production)",
      "Edit(./.env.test)",
      "Read(./config/holdout.lock)",
      "Read(./data/holdout/**)",
      "Edit(./config/holdout.lock)",
      "Edit(./data/holdout/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Edit|Write|NotebookEdit|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/claude-guard.ts\""
          }
        ]
      }
    ]
  }
}
