{
  "name": "jp-quant",
  "version": "1.0.1",
  "description": "Quantitative crypto research platform: deterministic backtester, strict risk engine and a local research dashboard (paper by default)",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/main.ts",
    "backtest": "node src/app/backtest-command.ts",
    "reproduce": "node src/app/reproduce-command.ts",
    "pbo-ronda": "node src/app/round-pbo-command.ts",
    "dashboard": "node src/app/dashboard-command.ts",
    "demo": "node demo/demo.ts",
    "demo:dca": "node demo/demo.ts --plan-b",
    "sello": "node src/app/seal-command.ts",
    "build": "node scripts/build.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "boundaries": "node scripts/boundaries.ts --ignore-known",
    "test": "node --test \"test/**/*.test.ts\"",
    "secrets": "node scripts/scan-secrets.ts",
    "check:all": "npm run build && npm run typecheck && npm run lint && npm run boundaries && npm test",
    "prepare": "git config core.hooksPath .githooks && git config merge.ff false"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.6-r.1",
    "big.js": "7.0.1",
    "ccxt": "4.5.84",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.6",
    "@types/big.js": "7.0.0",
    "@types/node": "^24.19.1",
    "dependency-cruiser": "^18.4.0",
    "eslint": "^10.11.0",
    "secretlint": "^13.0.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "overrides": {
    "undici": "7.30.1"
  }
}
