# Plantilla de variables de Inversor JP. Solo nombres, nunca valores: copia este archivo a .env (que Git ignora)
# y rellénalo en tu máquina. Detalle en docs/adr/0017-configuracion-tipada-y-arranque-seguro.md.
#
# En production el bot NO lee .env: si existe un .env* en la carpeta, no arranca. Allí los secretos van en el
# gestor de secretos (credenciales de systemd, un archivo por nombre en $CREDENTIALS_DIRECTORY), y APP_ENV y
# LIVE_TRADING los fija la unidad del servicio.

# Entorno: development, test, paper, shadow o production. Obligatorio (en el proceso o en config.json). No se
# lee de este archivo: escribirlo aquí detiene el arranque.

# Claves del exchange. Solo lectura y trading spot, sin retiros ni transferencias, con lista blanca de IP (M-05).
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=
EXCHANGE_API_PASSWORD=

# Avisos y panel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DASHBOARD_PASSWORD=
HEALTHCHECK_URL=

# Inteligencia (opcional).
ANTHROPIC_API_KEY=

# Dinero real. Fuera de production cualquier valor que no sea vacío o false detiene el arranque. En production
# lo fija una persona con la frase de confirmación (M-03); Claude no puede escribirla.
LIVE_TRADING=
